-- =========================================================
-- Load Bronze Layer
-- =========================================================

USE DataWarehouse;
GO

-- =========================================================
-- Create Stored Procedure
-- =========================================================

CREATE OR ALTER PROCEDURE bronze.load_bronze
AS
BEGIN

    PRINT '===========================================';
    PRINT 'Loading Bronze Layer';
    PRINT '===========================================';


    -- =====================================================
    -- CRM: Customer Information
    -- =====================================================

    PRINT 'Loading bronze.crm_cust_info...';

    TRUNCATE TABLE bronze.crm_cust_info;

    DECLARE @start_time DATETIME,
            @end_time DATETIME;

    SET @start_time = GETDATE();

    BULK INSERT bronze.crm_cust_info
    FROM 'C:\Users\vvkri\Desktop\sql_datawarehouse\datasets\source_crm\cust_info.csv'
    WITH (
        FIRSTROW = 2,
        FIELDTERMINATOR = ',',
        TABLOCK
    );

    SET @end_time = GETDATE();

    PRINT 'CRM Customer Load Completed';
    PRINT 'Duration: '
        + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR(20))
        + ' seconds';


    -- =====================================================
    -- CRM: Product Information
    -- =====================================================

    PRINT 'Loading bronze.crm_prd_info...';

    TRUNCATE TABLE bronze.crm_prd_info;

    SET @start_time = GETDATE();

    BULK INSERT bronze.crm_prd_info
    FROM 'C:\Users\vvkri\Desktop\sql_datawarehouse\datasets\source_crm\prd_info.csv'
    WITH (
        FIRSTROW = 2,
        FIELDTERMINATOR = ',',
        TABLOCK
    );

    SET @end_time = GETDATE();

    PRINT 'CRM Product Load Completed';
    PRINT 'Duration: '
        + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR(20))
        + ' seconds';


    -- =====================================================
    -- CRM: Sales Details
    -- =====================================================

    PRINT 'Loading bronze.crm_sales_details...';

    TRUNCATE TABLE bronze.crm_sales_details;

    SET @start_time = GETDATE();

    BULK INSERT bronze.crm_sales_details
    FROM 'C:\Users\vvkri\Desktop\sql_datawarehouse\datasets\source_crm\sales_details.csv'
    WITH (
        FIRSTROW = 2,
        FIELDTERMINATOR = ',',
        TABLOCK
    );

    SET @end_time = GETDATE();

    PRINT 'CRM Sales Load Completed';
    PRINT 'Duration: '
        + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR(20))
        + ' seconds';


    -- =====================================================
    -- ERP: Location Information
    -- =====================================================

    PRINT 'Loading bronze.erp_loc_a101...';

    TRUNCATE TABLE bronze.erp_loc_a101;

    SET @start_time = GETDATE();

    BULK INSERT bronze.erp_loc_a101
    FROM 'C:\Users\vvkri\Desktop\sql_datawarehouse\datasets\source_erp\LOC_A101.csv'
    WITH (
        FIRSTROW = 2,
        FIELDTERMINATOR = ',',
        TABLOCK
    );

    SET @end_time = GETDATE();

    PRINT 'ERP Location Load Completed';
    PRINT 'Duration: '
        + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR(20))
        + ' seconds';


    -- =====================================================
    -- ERP: Customer Information
    -- =====================================================

    PRINT 'Loading bronze.erp_cust_az12...';

    TRUNCATE TABLE bronze.erp_cust_az12;

    SET @start_time = GETDATE();

    BULK INSERT bronze.erp_cust_az12
    FROM 'C:\Users\vvkri\Desktop\sql_datawarehouse\datasets\source_erp\CUST_AZ12.csv'
    WITH (
        FIRSTROW = 2,
        FIELDTERMINATOR = ',',
        TABLOCK
    );

    SET @end_time = GETDATE();

    PRINT 'ERP Customer Load Completed';
    PRINT 'Duration: '
        + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR(20))
        + ' seconds';


    -- =====================================================
    -- ERP: Product Category
    -- =====================================================

    PRINT 'Loading bronze.erp_pr_cat_g1v2...';

    TRUNCATE TABLE bronze.erp_pr_cat_g1v2;

    SET @start_time = GETDATE();

    BULK INSERT bronze.erp_pr_cat_g1v2
    FROM 'C:\Users\vvkri\Desktop\sql_datawarehouse\datasets\source_erp\PX_CAT_G1V2.csv'
    WITH (
        FIRSTROW = 2,
        FIELDTERMINATOR = ',',
        TABLOCK
    );

    SET @end_time = GETDATE();

    PRINT 'ERP Product Category Load Completed';
    PRINT 'Duration: '
        + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR(20))
        + ' seconds';


    -- =====================================================
    -- Completion Message
    -- =====================================================

    PRINT '===========================================';
    PRINT 'Bronze Layer Loaded Successfully';
    PRINT '===========================================';

END;
GO


-- =========================================================
-- Execute Bronze Layer Load
-- =========================================================

EXEC bronze.load_bronze;
GO

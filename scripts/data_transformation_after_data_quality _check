-- =========================================================
-- Data Warehouse: Silver Layer Transformations
-- =========================================================
-- Purpose:
--     This script transforms and cleans data from the Bronze
--     layer before loading it into the Silver layer.
--
-- Transformations include:
--     1. Removing duplicate records
--     2. Trimming unwanted spaces
--     3. Standardizing categorical values
--     4. Handling NULL and invalid values
--     5. Converting data types
--     6. Standardizing keys and identifiers
--     7. Validating and correcting business values
--     8. Creating product validity periods
--
-- Bronze Layer:
--     Raw data with minimal transformations
--
-- Silver Layer:
--     Cleaned, standardized and business-ready data
-- =========================================================


USE DataWarehouse;
GO


-- =========================================================
-- 1. CRM CUSTOMER INFORMATION
-- =========================================================

-- ---------------------------------------------------------
-- Check duplicate customer records
-- Keep the most recent record for each customer based on
-- cst_create_date.
-- ---------------------------------------------------------

SELECT *
FROM bronze.crm_cust_info
WHERE cst_id = 29449;


SELECT *
FROM (
    SELECT *,
           ROW_NUMBER() OVER (
               PARTITION BY cst_id
               ORDER BY cst_create_date DESC
           ) AS flag_last
    FROM bronze.crm_cust_info
    WHERE cst_id IS NOT NULL
) t
WHERE flag_last = 1;


-- ---------------------------------------------------------
-- Clean Customer Names
-- Remove leading and trailing spaces.
-- ---------------------------------------------------------

SELECT
    cst_id,
    cst_key,
    TRIM(cst_firstname) AS cst_firstname,
    TRIM(cst_lastname) AS cst_lastname,
    cst_material_status,
    cst_gndr,
    cst_create_date
FROM (
    SELECT *,
           ROW_NUMBER() OVER (
               PARTITION BY cst_id
               ORDER BY cst_create_date DESC
           ) AS flag_last
    FROM bronze.crm_cust_info
    WHERE cst_id IS NOT NULL
) t
WHERE flag_last = 1;


-- ---------------------------------------------------------
-- Standardize Gender
--
-- F -> Female
-- M -> Male
-- Other/NULL -> n/a
-- ---------------------------------------------------------

SELECT
    cst_id,
    cst_key,
    TRIM(cst_firstname) AS cst_firstname,
    TRIM(cst_lastname) AS cst_lastname,

    cst_material_status,

    CASE
        WHEN UPPER(TRIM(cst_gndr)) = 'F'
            THEN 'Female'
        WHEN UPPER(TRIM(cst_gndr)) = 'M'
            THEN 'Male'
        ELSE 'n/a'
    END AS cst_gndr,

    cst_create_date

FROM (
    SELECT *,
           ROW_NUMBER() OVER (
               PARTITION BY cst_id
               ORDER BY cst_create_date DESC
           ) AS flag_last
    FROM bronze.crm_cust_info
    WHERE cst_id IS NOT NULL
) t

WHERE flag_last = 1;


-- ---------------------------------------------------------
-- Standardize Marital Status and Gender
--
-- Marital Status:
--     S -> Single
--     M -> Married
--
-- Gender:
--     F -> Female
--     M -> Male
-- ---------------------------------------------------------

SELECT
    cst_id,
    cst_key,

    TRIM(cst_firstname) AS cst_firstname,
    TRIM(cst_lastname) AS cst_lastname,

    CASE
        WHEN UPPER(TRIM(cst_material_status)) = 'S'
            THEN 'Single'
        WHEN UPPER(TRIM(cst_material_status)) = 'M'
            THEN 'Married'
        ELSE 'n/a'
    END AS cst_material_status,

    CASE
        WHEN UPPER(TRIM(cst_gndr)) = 'F'
            THEN 'Female'
        WHEN UPPER(TRIM(cst_gndr)) = 'M'
            THEN 'Male'
        ELSE 'n/a'
    END AS cst_gndr,

    cst_create_date

FROM (
    SELECT *,
           ROW_NUMBER() OVER (
               PARTITION BY cst_id
               ORDER BY cst_create_date DESC
           ) AS flag_last
    FROM bronze.crm_cust_info
    WHERE cst_id IS NOT NULL
) t

WHERE flag_last = 1;



-- =========================================================
-- 2. CRM PRODUCT INFORMATION
-- =========================================================

-- ---------------------------------------------------------
-- Transform Product Key
--
-- Original:
--     AC-HE-HL-U509-R
--
-- Category ID:
--     AC_HE
--
-- Product Key:
--     HL-U509-R
-- ---------------------------------------------------------

SELECT
    prd_id,

    REPLACE(
        SUBSTRING(prd_key, 1, 5),
        '-',
        '_'
    ) AS cat_id,

    SUBSTRING(
        prd_key,
        7,
        LEN(prd_key)
    ) AS prd_key,

    prd_nm,

    -- Replace NULL product cost with 0
    ISNULL(prd_cost, 0) AS prd_cost,

    -- Standardize product line
    CASE UPPER(TRIM(prd_line))
        WHEN 'M' THEN 'Mountain'
        WHEN 'R' THEN 'Road'
        WHEN 'S' THEN 'Other Sales'
        WHEN 'T' THEN 'Touring'
        ELSE 'n/a'
    END AS prd_line,

    -- Convert datetime to date
    CAST(prd_start_dt AS DATE) AS prd_start_dt,

    -- Calculate product end date using the next
    -- product start date.
    CAST(
        LEAD(prd_start_dt) OVER (
            PARTITION BY prd_key
            ORDER BY prd_start_dt
        ) - 1
        AS DATE
    ) AS prd_end_dt

FROM bronze.crm_prd_info;



-- =========================================================
-- 3. CRM SALES DETAILS
-- =========================================================

-- ---------------------------------------------------------
-- Convert Integer Dates
--
-- Source format:
--     YYYYMMDD
--
-- Example:
--     20240115 -> 2024-01-15
--
-- Invalid values such as 0 or incorrect length
-- are converted to NULL.
-- ---------------------------------------------------------

SELECT
    sls_ord_num,
    sls_prd_key,
    sls_cust_id,

    CASE
        WHEN sls_order_dt = 0
          OR LEN(sls_order_dt) != 8
            THEN NULL
        ELSE CAST(
            CAST(sls_order_dt AS VARCHAR(8))
            AS DATE
        )
    END AS sls_order_dt,

    CASE
        WHEN sls_ship_dt = 0
          OR LEN(sls_ship_dt) != 8
            THEN NULL
        ELSE CAST(
            CAST(sls_ship_dt AS VARCHAR(8))
            AS DATE
        )
    END AS sls_ship_dt,

    CASE
        WHEN sls_due_dt = 0
          OR LEN(sls_due_dt) != 8
            THEN NULL
        ELSE CAST(
            CAST(sls_due_dt AS VARCHAR(8))
            AS DATE
        )
    END AS sls_due_dt,


    -- -----------------------------------------------------
    -- Validate Sales Amount
    --
    -- Business Rule:
    --     Sales = Quantity × Price
    --
    -- If sales is NULL, <= 0, or inconsistent,
    -- calculate it from quantity and price.
    -- -----------------------------------------------------

    CASE
        WHEN sls_sales IS NULL
          OR sls_sales <= 0
          OR sls_sales != sls_quantity * ABS(sls_price)
            THEN sls_quantity * ABS(sls_price)
        ELSE sls_sales
    END AS sls_sales,

    sls_quantity,


    -- -----------------------------------------------------
    -- Validate Price
    --
    -- If price is NULL or <= 0, calculate price using:
    --
    --     Sales / Quantity
    --
    -- NULLIF prevents division by zero.
    -- -----------------------------------------------------

    CASE
        WHEN sls_price <= 0
          OR sls_price IS NULL
            THEN sls_sales / NULLIF(sls_quantity, 0)
        ELSE sls_price
    END AS sls_price

FROM bronze.crm_sales_details;



-- =========================================================
-- 4. ERP CUSTOMER INFORMATION
-- =========================================================

SELECT

    -- -----------------------------------------------------
    -- Remove NAS prefix from customer ID
    --
    -- Example:
    --     NAS12345 -> 12345
    -- -----------------------------------------------------

    CASE
        WHEN cid LIKE 'NAS%'
            THEN SUBSTRING(cid, 4, LEN(cid))
        ELSE cid
    END AS cid,


    -- -----------------------------------------------------
    -- Validate Birth Date
    --
    -- Future birth dates are converted to NULL.
    -- -----------------------------------------------------

    CASE
        WHEN bdate > GETDATE()
            THEN NULL
        ELSE bdate
    END AS bdate,


    -- -----------------------------------------------------
    -- Standardize Gender
    --
    -- F / Feamle -> Female
    -- M / Male   -> Male
    -- Other      -> n/a
    -- -----------------------------------------------------

    CASE
        WHEN UPPER(TRIM(gen)) IN ('F', 'FEAMLE')
            THEN 'Female'
        WHEN UPPER(TRIM(gen)) IN ('M', 'MALE')
            THEN 'Male'
        ELSE 'n/a'
    END AS gen

FROM bronze.erp_cust_az12;



-- =========================================================
-- 5. ERP LOCATION INFORMATION
-- =========================================================

SELECT

    -- Remove '-' from customer ID
    REPLACE(cid, '-', '') AS cid,

    -- -----------------------------------------------------
    -- Standardize Country Names
    --
    -- DE       -> Germany
    -- US / USA -> United States
    -- NULL     -> n/a
    -- -----------------------------------------------------

    CASE
        WHEN TRIM(cntry) = 'DE'
            THEN 'Germany'

        WHEN TRIM(cntry) IN ('US', 'USA')
            THEN 'United States'

        WHEN TRIM(cntry) = ''
          OR cntry IS NULL
            THEN 'n/a'

        ELSE TRIM(cntry)
    END AS cntry

FROM bronze.erp_loc_a101;



-- =========================================================
-- 6. ERP PRODUCT CATEGORY
-- =========================================================

-- ---------------------------------------------------------
-- Product Category data requires minimal transformation.
-- Values are already structurally suitable for the Silver
-- layer.
-- ---------------------------------------------------------

SELECT
    id,
    cat,
    subcat,
    maintenance
FROM bronze.erp_pr_cat_g1v2;


-- =========================================================
-- End of Silver Layer Transformations
-- =========================================================

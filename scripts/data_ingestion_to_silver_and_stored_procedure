-- =========================================================
-- Data Warehouse: Load Silver Layer
-- =========================================================
-- Purpose:
--     This stored procedure loads transformed and cleaned
--     data from the Bronze layer into the Silver layer.
--
-- Process:
--     1. Truncate existing Silver tables
--     2. Extract data from Bronze tables
--     3. Apply data cleansing and transformation rules
--     4. Insert transformed data into Silver tables
--
-- Silver Layer Responsibilities:
--     - Remove duplicates
--     - Handle NULL values
--     - Remove unwanted spaces
--     - Standardize categorical values
--     - Convert data types
--     - Correct invalid business values
--     - Create derived fields
--
-- Execution:
--     EXEC silver.load_silver;
-- =========================================================


USE DataWarehouse;
GO


-- =========================================================
-- Create / Alter Silver Loading Procedure
-- =========================================================

CREATE OR ALTER PROCEDURE silver.load_silver
AS
BEGIN

    -- =====================================================
    -- Start Silver Layer Loading
    -- =====================================================

    PRINT '===========================================';
    PRINT 'Loading Silver Layer';
    PRINT '===========================================';


    -- =====================================================
    -- 1. CRM CUSTOMER INFORMATION
    -- =====================================================

    PRINT '>> Loading: silver.crm_cust_info';

    -- Remove existing data before reloading
    TRUNCATE TABLE silver.crm_cust_info;


    INSERT INTO silver.crm_cust_info (
        cst_id,
        cst_key,
        cst_firstname,
        cst_lastname,
        cst_material_status,
        cst_gndr,
        cst_create_date
    )

    SELECT
        cst_id,
        cst_key,

        -- Remove leading/trailing spaces
        TRIM(cst_firstname) AS cst_firstname,
        TRIM(cst_lastname) AS cst_lastname,

        -- Standardize marital status
        CASE
            WHEN UPPER(TRIM(cst_material_status)) = 'S'
                THEN 'Single'
            WHEN UPPER(TRIM(cst_material_status)) = 'M'
                THEN 'Married'
            ELSE 'n/a'
        END AS cst_material_status,

        -- Standardize gender
        CASE
            WHEN UPPER(TRIM(cst_gndr)) = 'F'
                THEN 'Female'
            WHEN UPPER(TRIM(cst_gndr)) = 'M'
                THEN 'Male'
            ELSE 'n/a'
        END AS cst_gndr,

        cst_create_date

    FROM (
        SELECT
            *,
            ROW_NUMBER() OVER (
                PARTITION BY cst_id
                ORDER BY cst_create_date DESC
            ) AS flag_last

        FROM bronze.crm_cust_info

        WHERE cst_id IS NOT NULL
    ) t

    -- Keep only the latest customer record
    WHERE flag_last = 1;


    -- =====================================================
    -- 2. CRM PRODUCT INFORMATION
    -- =====================================================

    PRINT '>> Loading: silver.crm_prd_info';

    TRUNCATE TABLE silver.crm_prd_info;


    INSERT INTO silver.crm_prd_info (
        prd_id,
        cat_id,
        prd_key,
        prd_nm,
        prd_cost,
        prd_line,
        prd_start_dt,
        prd_end_dt
    )

    SELECT
        prd_id,

        -- Extract category ID
        -- Example: AC-HE -> AC_HE
        REPLACE(
            SUBSTRING(prd_key, 1, 5),
            '-',
            '_'
        ) AS cat_id,

        -- Remove category prefix from product key
        SUBSTRING(
            prd_key,
            7,
            LEN(prd_key)
        ) AS prd_key,

        prd_nm,

        -- Replace NULL product cost with 0
        ISNULL(prd_cost, 0) AS prd_cost,

        -- Standardize product line
        CASE UPPER(TRIM(prd_line))
            WHEN 'M' THEN 'Mountain'
            WHEN 'R' THEN 'Road'
            WHEN 'S' THEN 'Other Sales'
            WHEN 'T' THEN 'Touring'
            ELSE 'n/a'
        END AS prd_line,

        -- Convert datetime to date
        CAST(prd_start_dt AS DATE) AS prd_start_dt,

        -- Generate product end date using the next
        -- product start date
        CAST(
            LEAD(prd_start_dt) OVER (
                PARTITION BY prd_key
                ORDER BY prd_start_dt
            ) - 1
            AS DATE
        ) AS prd_end_dt

    FROM bronze.crm_prd_info;


    -- =====================================================
    -- 3. CRM SALES DETAILS
    -- =====================================================

    PRINT '>> Loading: silver.crm_sales_details';

    TRUNCATE TABLE silver.crm_sales_details;


    INSERT INTO silver.crm_sales_details (
        sls_ord_num,
        sls_prd_key,
        sls_cust_id,
        sls_order_dt,
        sls_ship_dt,
        sls_due_dt,
        sls_sales,
        sls_quantity,
        sls_price
    )

    SELECT
        sls_ord_num,
        sls_prd_key,
        sls_cust_id,


        -- -------------------------------------------------
        -- Convert order date from YYYYMMDD integer
        -- into DATE.
        -- -------------------------------------------------

        CASE
            WHEN sls_order_dt = 0
              OR LEN(sls_order_dt) != 8
                THEN NULL

            ELSE CAST(
                CAST(sls_order_dt AS VARCHAR(8))
                AS DATE
            )
        END AS sls_order_dt,


        -- Convert ship date
        CASE
            WHEN sls_ship_dt = 0
              OR LEN(sls_ship_dt) != 8
                THEN NULL

            ELSE CAST(
                CAST(sls_ship_dt AS VARCHAR(8))
                AS DATE
            )
        END AS sls_ship_dt,


        -- Convert due date
        CASE
            WHEN sls_due_dt = 0
              OR LEN(sls_due_dt) != 8
                THEN NULL

            ELSE CAST(
                CAST(sls_due_dt AS VARCHAR(8))
                AS DATE
            )
        END AS sls_due_dt,


        -- -------------------------------------------------
        -- Validate sales amount.
        --
        -- Business rule:
        -- Sales = Quantity × Price
        --
        -- If sales is NULL, <= 0 or incorrect,
        -- calculate it using quantity × absolute price.
        -- -------------------------------------------------

        CASE
            WHEN sls_sales IS NULL
              OR sls_sales <= 0
              OR sls_sales != sls_quantity * ABS(sls_price)

                THEN sls_quantity * ABS(sls_price)

            ELSE sls_sales
        END AS sls_sales,


        sls_quantity,


        -- -------------------------------------------------
        -- Validate price.
        --
        -- If price is NULL or <= 0, calculate:
        --
        -- Price = Sales / Quantity
        --
        -- NULLIF prevents division by zero.
        -- -------------------------------------------------

        CASE
            WHEN sls_price <= 0
              OR sls_price IS NULL

                THEN sls_sales / NULLIF(sls_quantity, 0)

            ELSE sls_price
        END AS sls_price

    FROM bronze.crm_sales_details;


    -- =====================================================
    -- 4. ERP CUSTOMER INFORMATION
    -- =====================================================

    PRINT '>> Loading: silver.erp_cust_az12';

    TRUNCATE TABLE silver.erp_cust_az12;


    INSERT INTO silver.erp_cust_az12 (
        cid,
        bdate,
        gen
    )

    SELECT

        -- -------------------------------------------------
        -- Remove NAS prefix from customer ID
        --
        -- NAS12345 -> 12345
        -- -------------------------------------------------

        CASE
            WHEN cid LIKE 'NAS%'
                THEN SUBSTRING(cid, 4, LEN(cid))
            ELSE cid
        END AS cid,


        -- -------------------------------------------------
        -- Validate birth date.
        -- Future dates are converted to NULL.
        -- -------------------------------------------------

        CASE
            WHEN bdate > GETDATE()
                THEN NULL
            ELSE bdate
        END AS bdate,


        -- -------------------------------------------------
        -- Standardize gender
        -- -------------------------------------------------

        CASE
            WHEN UPPER(TRIM(gen)) IN ('F', 'FEAMLE')
                THEN 'Female'

            WHEN UPPER(TRIM(gen)) IN ('M', 'MALE')
                THEN 'Male'

            ELSE 'n/a'
        END AS gen

    FROM bronze.erp_cust_az12;


    -- =====================================================
    -- 5. ERP LOCATION INFORMATION
    -- =====================================================

    PRINT '>> Loading: silver.erp_loc_a101';

    TRUNCATE TABLE silver.erp_loc_a101;


    INSERT INTO silver.erp_loc_a101 (
        cid,
        cntry
    )

    SELECT

        -- Remove '-' from customer ID
        REPLACE(cid, '-', '') AS cid,


        -- -------------------------------------------------
        -- Standardize country names
        -- -------------------------------------------------

        CASE
            WHEN TRIM(cntry) = 'DE'
                THEN 'Germany'

            WHEN TRIM(cntry) IN ('US', 'USA')
                THEN 'United States'

            WHEN TRIM(cntry) = ''
              OR cntry IS NULL
                THEN 'n/a'

            ELSE TRIM(cntry)
        END AS cntry

    FROM bronze.erp_loc_a101;


    -- =====================================================
    -- 6. ERP PRODUCT CATEGORY
    -- =====================================================

    PRINT '>> Loading: silver.erp_pr_cat_g1v2';

    TRUNCATE TABLE silver.erp_pr_cat_g1v2;


    INSERT INTO silver.erp_pr_cat_g1v2 (
        id,
        cat,
        subcat,
        maintenance
    )

    SELECT
        id,
        cat,
        subcat,
        maintenance

    FROM bronze.erp_pr_cat_g1v2;


    -- =====================================================
    -- Silver Layer Loading Completed
    -- =====================================================

    PRINT '===========================================';
    PRINT 'Silver Layer Loading Completed';
    PRINT '===========================================';

END;
GO



-- =========================================================
-- Execute Silver Layer Loading Procedure
-- =========================================================

EXEC silver.load_silver;
GO



-- =========================================================
-- Silver Layer Validation
-- =========================================================

SELECT COUNT(*) AS customer_count
FROM silver.crm_cust_info;

SELECT COUNT(*) AS product_count
FROM silver.crm_prd_info;

SELECT COUNT(*) AS sales_count
FROM silver.crm_sales_details;

SELECT COUNT(*) AS erp_customer_count
FROM silver.erp_cust_az12;

SELECT COUNT(*) AS location_count
FROM silver.erp_loc_a101;

SELECT COUNT(*) AS category_count
FROM silver.erp_prd_cat_g1v2;
GO
